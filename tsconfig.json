{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@app/*": [
                "./src/app/*"
            ], // access to rounting
            "@web/*": [
                "./src/components/web/*"
            ], // access to web components
            "@admin/*": [
                "./src/components/admin/*"
            ], // access to admin components
            "@src/*": [
                "./src/*"
            ], // access to src folder
            "@lib/*": [
                "./src/lib/*"
            ] // access to public files
        },
        "jsx": "react-jsx",
        "target": "ES2017",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": false,
        "noEmit": true,
        "incremental": true,
        "module": "esnext",
        "esModuleInterop": true,
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "plugins": [
            {
                "name": "next"
            }
        ]
    },
    "include": [
        "next-env.d.ts",
        ".next/types/**/*.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/dev/types/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ],
    "noEmitOnError": true
}